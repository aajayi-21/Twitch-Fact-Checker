# Live Stream Fact-Checker — backend configuration
#
# Copy to backend/.env and fill in what you need. Every value here shows the
# default; commented lines are optional overrides. IMPORTANT: keep comments on
# their OWN lines — python-dotenv parses an inline comment after an empty
# value as the value itself.

# --------------------------------------------------------------------------- #
# LLM provider selection
# --------------------------------------------------------------------------- #
# Legacy single-provider switch: openrouter | gemini. Used for BOTH pipeline
# stages unless the per-stage overrides below are set.
LLM_PROVIDER=openrouter

# Per-stage overrides (empty = follow LLM_PROVIDER).
# Claim detection ("gate"): openrouter | gemini | ollama
# Verification: openrouter | gemini  (local verify is not supported — the
# verify stage needs web-search grounding)
GATE_PROVIDER=
VERIFY_PROVIDER=

# --------------------------------------------------------------------------- #
# OpenRouter (https://openrouter.ai/keys)
# --------------------------------------------------------------------------- #
# Backend-only. Never ship a key in the extension.
# Web search bills credits even on :free models — hold a small balance.
OPENROUTER_API_KEY=
# Model slugs. Browse them at https://openrouter.ai/models — note that a
# paid model and its ":free" variant are DISTINCT slugs. These can also be
# set from the extension's options page, which validates them against
# OpenRouter's live catalogue before saving.
# OPENROUTER_GATE_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_VERIFY_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_WEB_MAX_RESULTS=5
# Reasoning-effort cap; empty string = never send the reasoning field.
# OPENROUTER_REASONING_EFFORT=low

# --------------------------------------------------------------------------- #
# Gemini (https://aistudio.google.com/apikey — search grounding needs a
# paid-tier key)
# --------------------------------------------------------------------------- #
GEMINI_API_KEY=
# GEMINI_GATE_MODEL=gemini-3.1-flash-lite
# GEMINI_VERIFY_MODEL=gemini-3.5-flash

# --------------------------------------------------------------------------- #
# Ollama (local, keyless — https://ollama.com)
# --------------------------------------------------------------------------- #
# The OpenAI-compatible root (keep the /v1; embeddings derive the native root
# from it automatically). Also works for LM Studio/vLLM/llama.cpp servers.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Small instruct model for the claim gate; pull it first: ollama pull gemma3:4b
# A cold model's first call can exceed GATE_TIMEOUT_S — consider raising it
# and setting a longer Ollama keep_alive.
# OLLAMA_GATE_MODEL=gemma3:4b
# Embedding model for contradiction detection: ollama pull nomic-embed-text
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --------------------------------------------------------------------------- #
# Speech-to-text
# --------------------------------------------------------------------------- #
# Engine:
#   faster-whisper (default) - ctranslate2. Fastest on CPU. Devices: cpu, cuda.
#                              WHISPER_MODEL is a ctranslate2 name.
#   torch                    - transformers + PyTorch. The ONLY way to use an
#                              Intel XPU or AMD ROCm GPU. WHISPER_MODEL is a
#                              Hugging Face repo id. Install it first with
#                              ./scripts/install_stt_gpu.sh
STT_BACKEND=faster-whisper

# faster-whisper name (distil-small.en, base, large-v3) OR, with
# STT_BACKEND=torch, a Hugging Face repo id such as:
#   openai/whisper-small.en, openai/whisper-large-v3-turbo,
#   distil-whisper/distil-small.en
WHISPER_MODEL=distil-small.en

# cpu | cuda | rocm | xpu | auto
# "auto" probes cuda -> xpu -> cpu. "rocm" is PyTorch's HIP build, which
# reports itself through the CUDA API; the torch backend checks that
# distinction so a misconfigured GPU fails loudly instead of silently
# falling back to CPU. faster-whisper accepts only cpu/cuda/auto.
# WHISPER_DEVICE=cpu

# faster-whisper: a ctranslate2 quantization (int8, float16, ...).
# torch: mapped onto a dtype (int8 -> float32 on CPU, float16 on GPU);
# float16/bfloat16/float32 are also accepted directly.
# WHISPER_COMPUTE_TYPE=int8

# Transcription language. Empty = derive it (an English-only checkpoint pins
# "en", anything else auto-detects). Set it for a multilingual model on a
# known-language stream.
# WHISPER_LANGUAGE=

# --------------------------------------------------------------------------- #
# Pipeline tuning
# --------------------------------------------------------------------------- #
# STT_WINDOW_S=4.0
# STT_HOP_S=3.5
# MAX_AUDIO_BUFFER_S=30.0
# AUDIO_HIGH_WATERMARK_S=12.0
# AUDIO_LOW_WATERMARK_S=8.0
# GATE_INTERVAL_S=12.0
# GATE_TIMEOUT_S=15.0
# VERIFY_RPM=8.0
# VERIFY_TIMEOUT_S=45.0
# SEND_TRANSCRIPTS=true
# DEBUG_ENDPOINTS=true
# Attach a captured stream frame to verification when the claim references
# something on screen (frames only arrive if the extension toggle is on).
# VISION_ENABLED=true

# --------------------------------------------------------------------------- #
# Analytics
# --------------------------------------------------------------------------- #
# SQLite analytics database (sessions/claims/verdicts/feedback). Delete the
# file to reset. Dashboard: http://127.0.0.1:8710/dashboard
# DB_PATH=./fact_checker.db
# Estimated cost of one verification attempt (web-search fee), for the
# popup/dashboard cost readouts.
# COST_PER_VERIFY_USD=0.005

# --------------------------------------------------------------------------- #
# Server
# --------------------------------------------------------------------------- #
# HOST=127.0.0.1
# PORT=8710
# LOG_LEVEL=INFO
