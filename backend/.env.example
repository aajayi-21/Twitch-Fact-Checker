# Live Stream Fact-Checker — backend configuration
#
# Copy to backend/.env and fill in what you need. Every value here shows the
# default; commented lines are optional overrides. IMPORTANT: keep comments on
# their OWN lines — python-dotenv parses an inline comment after an empty
# value as the value itself.

# --------------------------------------------------------------------------- #
# LLM provider selection
# --------------------------------------------------------------------------- #
# Legacy single-provider switch: openrouter | gemini. Used for BOTH pipeline
# stages unless the per-stage overrides below are set.
LLM_PROVIDER=openrouter

# Per-stage overrides (empty = follow LLM_PROVIDER).
# Claim detection ("gate"): openrouter | gemini | ollama
# Verification: openrouter | gemini  (local verify is not supported — the
# verify stage needs web-search grounding)
GATE_PROVIDER=
VERIFY_PROVIDER=

# --------------------------------------------------------------------------- #
# OpenRouter (https://openrouter.ai/keys)
# --------------------------------------------------------------------------- #
# Backend-only. Never ship a key in the extension.
# Web search bills credits even on :free models — hold a small balance.
OPENROUTER_API_KEY=
# Model slugs. Browse them at https://openrouter.ai/models — note that a
# paid model and its ":free" variant are DISTINCT slugs. These can also be
# set from the extension's options page, which validates them against
# OpenRouter's live catalogue before saving.
# The backend reads each model's supported_parameters from OpenRouter's public
# catalogue at boot and on Apply: temperature, reasoning and strict JSON are
# only sent to models that list them (e.g. OpenAI GPT-5.x rejects
# temperature), so a model never silently drops into the text fallback chain.
# Jev uses the Decisions API to screen batches. Only approved batches go to
# the extraction model, then existing filters, then web-grounded verification.
# A generative gate slug opts back into the legacy gate without Jev.
# OPENROUTER_GATE_MODEL=~typesafe/jev-latest
# OPENROUTER_EXTRACTION_MODEL=inception/mercury-2.5-preview
# Probability that checkable content exists, NOT probability of truth.
# Permissive initial policy: uncertain batches may reach claim extraction.
# JEV_MIN_CHECK_PROBABILITY=0.35
# OPENROUTER_VERIFY_MODEL=inception/mercury-2.5-preview
# OPENROUTER_WEB_MAX_RESULTS=5
# Web-search engine for verification: exa (default, works for every model,
# $0.007/request) | native (the model provider's own search; pricier, fails
# on models without one) | auto (native when available, else Exa).
# OPENROUTER_WEB_ENGINE=exa
# Reasoning-effort cap; empty string = never send the reasoning field.
# OPENROUTER_REASONING_EFFORT=low

# --------------------------------------------------------------------------- #
# Gemini — OPTIONAL secondary provider (https://aistudio.google.com/apikey).
# Search grounding needs a paid-tier key; OpenRouter above is the primary.
# --------------------------------------------------------------------------- #
GEMINI_API_KEY=
# GEMINI_GATE_MODEL=gemini-3.1-flash-lite
# GEMINI_VERIFY_MODEL=gemini-3.5-flash

# --------------------------------------------------------------------------- #
# Ollama (local, keyless — https://ollama.com)
# --------------------------------------------------------------------------- #
# The OpenAI-compatible root (keep the /v1; embeddings derive the native root
# from it automatically). Also works for LM Studio/vLLM/llama.cpp servers.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Small instruct model for the claim gate; pull it first: ollama pull gemma3:4b
# A cold model's first call can exceed GATE_TIMEOUT_S — consider raising it
# and setting a longer Ollama keep_alive.
# OLLAMA_GATE_MODEL=gemma3:4b
# Embedding model for contradiction detection: ollama pull nomic-embed-text
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --------------------------------------------------------------------------- #
# Speech-to-text
# --------------------------------------------------------------------------- #
# Engine:
#   faster-whisper (default) - ctranslate2. Fastest on CPU. Devices: cpu, cuda.
#                              WHISPER_MODEL is a ctranslate2 name.
#   torch                    - transformers + PyTorch. The ONLY way to use an
#                              Intel XPU or AMD ROCm GPU. WHISPER_MODEL is a
#                              Hugging Face repo id. Install it first with
#                              ./scripts/install_stt_gpu.sh
STT_BACKEND=faster-whisper

# faster-whisper name (distil-small.en, base, large-v3) OR, with
# STT_BACKEND=torch, a Hugging Face repo id such as:
#   openai/whisper-small.en, openai/whisper-large-v3-turbo,
#   distil-whisper/distil-small.en
WHISPER_MODEL=distil-small.en

# cpu | cuda | rocm | xpu | auto
# "auto" probes cuda -> xpu -> cpu. "rocm" is PyTorch's HIP build, which
# reports itself through the CUDA API; the torch backend checks that
# distinction so a misconfigured GPU fails loudly instead of silently
# falling back to CPU. faster-whisper accepts only cpu/cuda/auto.
# WHISPER_DEVICE=cpu

# faster-whisper: a ctranslate2 quantization (int8, float16, ...).
# torch: mapped onto a dtype (int8 -> float32 on CPU, float16 on GPU);
# float16/bfloat16/float32 are also accepted directly.
# WHISPER_COMPUTE_TYPE=int8

# Transcription language. Empty = derive it (an English-only checkpoint pins
# "en", anything else auto-detects). Set it for a multilingual model on a
# known-language stream.
# WHISPER_LANGUAGE=

# Resilience (app/stt_supervisor.py). Warm-up runs the whole inference path
# once at startup so GPU kernel compilation never stalls a live session.
# After STT_FAILURE_THRESHOLD consecutive failed windows (a poisoned GPU
# context fails every window) the engine is reloaded ONCE on the CPU and
# sessions continue degraded; with the fallback off, or if it fails too, the
# session ends with a fatal stt_failure frame and /healthz reports unhealthy.
# STT_WARM_UP=true
# STT_FAILURE_THRESHOLD=3
# STT_CPU_FALLBACK=true

# --------------------------------------------------------------------------- #
# Pipeline tuning
# --------------------------------------------------------------------------- #
# STT_WINDOW_S=4.0
# STT_HOP_S=3.5
# MAX_AUDIO_BUFFER_S=30.0
# AUDIO_HIGH_WATERMARK_S=12.0
# AUDIO_LOW_WATERMARK_S=8.0
# GATE_INTERVAL_S=12.0
# Total deadline for Jev decision + claim extraction (or the legacy gate).
# GATE_TIMEOUT_S=15.0
# VERIFY_RPM=8.0
# VERIFY_TIMEOUT_S=45.0
# SEND_TRANSCRIPTS=true
# DEBUG_ENDPOINTS=true
# Attach a captured stream frame to verification when the claim references
# something on screen (frames only arrive if the extension toggle is on).
# VISION_ENABLED=true

# --------------------------------------------------------------------------- #
# Analytics
# --------------------------------------------------------------------------- #
# SQLite analytics database (sessions/claims/verdicts/feedback). Delete the
# file to reset. Dashboard: http://127.0.0.1:8710/dashboard
# DB_PATH=./fact_checker.db
# Estimated cost of one verification attempt (web-search fee), for the
# popup/dashboard cost readouts.
# COST_PER_VERIFY_USD=0.005
# Persist a live session's running counters every N seconds (crash
# insurance for the analytics row; the final write still happens at end).
# SESSION_STATS_FLUSH_S=60

# --------------------------------------------------------------------------- #
# Server
# --------------------------------------------------------------------------- #
# HOST=127.0.0.1
# PORT=8710
# LOG_LEVEL=INFO
# Which live sessions a new /ws/audio connection preempts:
#   global (default) = any existing session; channel = same channel only;
#   none = never. See backend/app/sessions.py for why global stays default.
# SESSION_PREEMPT_SCOPE=global
# MAX_SESSIONS=4
# Per-subscriber mailbox depth on the event fan-out hub.
# EVENT_QUEUE_MAXSIZE=64

# =========================================================================== #
# STREAMER product (run-streamer.sh / streamer.main:app on port 8711)
# Everything below is read ONLY by the streamer backend; the viewer backend
# ignores it. The two share this .env file.
# =========================================================================== #

# --------------------------------------------------------------------------- #
# Twitch chat bot (the BOT account, not your main account)
# --------------------------------------------------------------------------- #
# Normally written by the control panel (http://127.0.0.1:8711/control) via
# "Connect with Twitch" or "Paste a token" — hand-editing works too.
# User token with scopes chat:read chat:edit; "oauth:" prefix optional.
# TWITCH_BOT_TOKEN=
# Rotating refresh token (Device Code Flow only; re-written on every refresh).
# TWITCH_BOT_REFRESH=
# Cached identity from /oauth2/validate (the panel fills these in).
# TWITCH_BOT_LOGIN=
# TWITCH_BOT_EXPIRES_AT=
# The channel to watch and post into (the broadcaster's login).
# TWITCH_CHANNEL=
# Public client id for "Connect with Twitch" (Device Code Flow + automatic
# token refresh). Register your own free app at dev.twitch.tv/console/apps
# (client type: Public; ids are public, but Twitch forbids sharing one app id
# across different applications). Empty = paste-token setup only.
# TWITCH_CLIENT_ID=
# Operator allowlist (consent proof #1); CSV. Empty = just TWITCH_CHANNEL.
# TWITCH_CHAT_CHANNELS=

# --------------------------------------------------------------------------- #
# Posting master switch
# --------------------------------------------------------------------------- #
# Dry run records every would-be post (the exact message text, in the panel's
# Recent decisions feed) and sends NOTHING. Deliberately defaults ON: flip it
# from the control panel only after reading a full stream's worth of
# would-have-posted messages. That reading is the pre-launch gate.
# CHAT_DRY_RUN=true

# --------------------------------------------------------------------------- #
# /ws/events (OBS overlay + control panel socket)
# --------------------------------------------------------------------------- #
# Optional shared token (?token=...) for when the backend is ever exposed
# beyond localhost. Generate a random string; NEVER reuse the Twitch token —
# query strings land in logs and OBS scene configs.
# EVENTS_TOKEN=
