# Secrets — never commit (backend/.env holds the real API keys)
.env
.env.*
!.env.example
backend/.env

# Local analytics database (app/db.py; WAL sidecars included)
backend/fact_checker.db*
backend/streamer.db*

# Python
backend/.venv/
**/__pycache__/
*.pyc
backend/.pytest_cache/

# Generated test fixtures (scripts/make_fixture_wav.py)
backend/tests/fixtures/*.wav

# In-browser speech runtime (scripts/vendor_stt_runtime.py; ~28 MB of WASM)
extension/vendor/transformers/

# Speech benchmark reports from this machine (scripts/run_stt_bench.mjs)
docs/spike-results/raw/

# Browser-spike working files: Chrome profiles (hold downloaded models) and
# patched extension copies. Kept on disk rather than in /tmp, which is RAM.
.stt-bench/

# Store packages (scripts/build_extension.py)
dist/
