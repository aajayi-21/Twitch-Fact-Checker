{
  "manifest_version": 3,
  "name": "Doxa: Live Stream Fact-Checker",
  "short_name": "Doxa",
  "version": "0.1.0",
  "description": "Fact-checks what is said in a live stream you are watching and shows sourced verdicts over the player.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "wss://127.0.0.1/*",
    "wss://localhost/*"
  ],
  "optional_host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Doxa",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16_off.png",
      "32": "icons/icon32_off.png",
      "48": "icons/icon48_off.png",
      "128": "icons/icon128_off.png"
    }
  },
  "options_ui": {
    "page": "app/app.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://kick.com/*",
        "https://www.kick.com/*",
        "https://rumble.com/*"
      ],
      "js": ["content/overlay.js", "content/page_identity.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/overlay.css"],
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://kick.com/*",
        "https://www.kick.com/*",
        "https://rumble.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
